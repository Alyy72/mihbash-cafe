APP_NAME=Mihbash Cafe & Dining API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/mihbash.db
CORS_ORIGINS=http://localhost:3000

WEBHOOK_SECRET=change-me
TAX_RATE=0.05
CURRENCY=AED

# Payments — leave empty until live credentials are confirmed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ZIINA_API_KEY=
ZIINA_WEBHOOK_SECRET=

# Foodics POS — dry-run until live token is confirmed
FOODICS_BASE_URL=https://api.foodics.com/v5
FOODICS_API_TOKEN=
FOODICS_PAYMENT_METHOD_ID=
FOODICS_TIMEOUT_SECONDS=12
FOODICS_DRY_RUN=true

STAFF_TOKEN=dev-staff-token

# Owner WhatsApp — server only. Never shown on the website.
# Use the owner's mobile in international digits, no +, e.g. 9715XXXXXXXX
WHATSAPP_OWNER_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_CALLMEBOT_KEY=

# Collab form inbox — server only. Never shown on the website.
COLLAB_INBOX_EMAIL=mihbashacc@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=

# Map Mihbash rooms → Foodics branch UUIDs
BRANCH_UMM_SUQEIM=replace-with-foodics-branch-uuid
BRANCH_MARINA=replace-with-foodics-branch-uuid
BRANCH_DIFC=replace-with-foodics-branch-uuid
BRANCH_MARYAH=replace-with-foodics-branch-uuid
